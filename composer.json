{
  "name": "luminsports/linear-regression",
  "description": "Linear regression",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Dave Barnwell",
      "email": "dave.barnwell@freshsauce.co.uk"
    },
    {
      "name": "Ryan Brereton",
      "email": "ryan@luminsports.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "LuminSports\\LinearRegression\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LuminSports\\LinearRegression\\Test\\": "tests"
    }
  },
  "require": {
    "php": "^8.1",
    "ext-bcmath": "*",
    "brick/math": "^0.12|^0.13|^0.14|^0.15|^0.16|^0.17"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.13",
    "pestphp/pest": "^4.7.5",
    "phpstan/phpstan": "^2.2.5"
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage --min=100",
    "test:mutation": "pest --mutate --everything --covered-only --parallel",
    "phpstan": "phpstan analyse",
    "check-style": "php-cs-fixer fix --dry-run",
    "fix-style": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
